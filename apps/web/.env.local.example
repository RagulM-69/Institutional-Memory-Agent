# Institutional Memory Agent — Web Frontend Environment Configuration
# Copy this file to .env.local for local development.

# ── Supabase Public Browser Configuration ────────────────────────────────
# Safe to expose to the browser by design.
# Do NOT put SUPABASE_SERVICE_ROLE_KEY or database connection strings here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Backend API Configuration ─────────────────────────────────────────────
# Local development default: http://localhost:8000
# Production deployment: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
