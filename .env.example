# ── Supabase ──────────────────────────────────────────────────────────
# Your Supabase project URL (visible in Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# WARNING: Service role key bypasses Row Level Security.
# Backend only. Never expose to the frontend, logs, or git.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT secret for verifying user tokens (Project Settings → API → JWT Secret).
# Only needed for HS256 projects. See Phase 1 auth notes if your project uses RS256.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWKS_URL=

# ── PostgreSQL Database Connections (Restricted Roles) ──────────────────
# Application runtime role connection string (pooler port 6543)
DATABASE_URL=postgresql://app_runtime.your-project-ref:your-runtime-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Direct connection fallback (port 5432)
DIRECT_DATABASE_URL=postgresql://app_runtime:your-runtime-password@db.your-project-ref.supabase.co:5432/postgres
# Worker ingest role connection string (backend sync tasks only)
WORKER_DATABASE_URL=postgresql://app_sync.your-project-ref:your-sync-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Groq ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
# Model name kept in config. Verify current free-tier models at console.groq.com.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Connectors & Credentials ──────────────────────────────────────────
# Optional dedicated 32-byte encryption key for credentials at rest (AES-256-GCM).
# If omitted, securely derived from SUPABASE_JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=

# Server fallback tokens (used only if a source does not have per-org credentials)
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
SLACK_BOT_TOKEN=

# ── Multi-Tenant OAuth App Settings ───────────────────────────────────
# GitHub App / OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/sources/oauth/github/callback

# Jira Cloud OAuth 2.0 (3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/api/sources/oauth/jira/callback

# Slack OAuth 2.0 App
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/sources/oauth/slack/callback

# ── Agent ─────────────────────────────────────────────────────────────
AGENT_MAX_TOOL_CALLS=6

# ── Embeddings ────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

